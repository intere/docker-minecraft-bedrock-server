<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Upload Pack</h1>
  <a href="<%= packs_path %>" class="btn btn-secondary">Back to Packs</a>
</div>

<div class="card">
  <div class="card-body">
    <%= form_tag packs_path, multipart: true, method: :post do %>
      <div class="form-group">
        <label class="form-label" for="pack_file">Pack File</label>
        <%= file_field_tag :pack_file, accept: ".mcpack,.mcaddon,.zip", class: "form-input", id: "pack_file" %>
        <p class="form-hint">Upload a .mcpack, .mcaddon, or .zip file containing a manifest.json</p>
      </div>

      <div class="flex items-center gap-2 mt-4">
        <%= submit_tag "Upload", class: "btn btn-primary" %>
        <a href="<%= packs_path %>" class="btn btn-secondary">Cancel</a>
      </div>
    <% end %>
  </div>
</div>
