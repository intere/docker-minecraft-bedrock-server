<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Players</h1>
  <a href="<%= new_player_path %>" class="btn btn-primary btn-lg">+ Add Player</a>
</div>

<% if @players.any? %>
  <div class="card">
    <table class="data-table">
      <thead>
        <tr>
          <th>Gamertag</th>
          <th>XUID</th>
          <th style="width: 140px;"></th>
        </tr>
      </thead>
      <tbody>
        <% @players.each do |player| %>
          <tr>
            <td class="font-medium"><%= player.gamertag %></td>
            <td class="text-gray-400"><%= player.xuid %></td>
            <td class="text-right">
              <div class="flex items-center gap-2 justify-end">
                <a href="<%= edit_player_path(player) %>" class="btn btn-secondary btn-sm">Edit</a>
                <%= button_to "Delete", player_path(player), method: :delete, class: "btn btn-danger btn-sm", form: { data: { turbo_confirm: "Remove player '#{player.gamertag}'?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">
    <div class="empty-state-icon">
      <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="#6b7280" stroke-width="1.5" style="display:inline-block">
        <circle cx="12" cy="8" r="5"/>
        <path d="M3 21c0-4.5 4-7 9-7s9 2.5 9 7"/>
      </svg>
    </div>
    <div class="empty-state-title">No players yet</div>
    <p class="text-gray-500 mb-4">Add players to easily assign them as operators, members, or to the allow list.</p>
    <a href="<%= new_player_path %>" class="btn btn-primary btn-lg">+ Add Player</a>
  </div>
<% end %>
